mysql> SELECT
    ->     e.employee_id,
    ->     e.first_name,
    ->     e.last_name,
    ->     e.salary
    -> FROM employees e
    -> WHERE e.salary >
    -> (
    ->     SELECT AVG(e2.salary)
    ->     FROM employees e2
    ->     WHERE e2.department_id = e.department_id
    -> );
