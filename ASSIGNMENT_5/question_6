mysql> SELECT e.first_name, e.last_name, e.salary
    -> FROM employees e
    -> WHERE e.salary =
    -> (
    ->     SELECT jg.lowest_sal
    ->     FROM job_grades jg
    ->     WHERE e.salary BETWEEN jg.lowest_sal AND jg.highest_sal
    -> );
